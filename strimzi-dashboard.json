                }
            ],
            "title": "재조정 작업 빈도 (Reconciliations)",
            "type": "timeseries"
        },
        {
            "datasource": "${DS_PROMETHEUS}",
            "description": "재조정 작업에 소요되는 시간 (초)",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 1
            },
            "id": 4,
            "targets": [
                {
                    "expr": "strimzi_reconciliations_duration_seconds",
                    "legendFormat": "{{kind}} - {{le}}",
                    "refId": "A"
                }
            ],
            "title": "재조정 소요 시간 (Duration)",
            "type": "heatmap"
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 9
            },
            "id": 5,
            "panels": [],
            "title": "Kafka Cluster Statistics",
            "type": "row"
        },
        {
            "datasource": "${DS_PROMETHEUS}",
            "description": "현재 클러스터 내 활성 컨트롤러 수 (일반적으로 1)",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 10
            },
            "id": 6,
            "targets": [
                {
                    "expr": "kafka_controller_KafkaController_ActiveControllerCount",
                    "legendFormat": "Active Controllers",
                    "refId": "A"
                }
            ],
            "title": "활성 컨트롤러 수 (Active Controllers)",
            "type": "stat"
        },
        {
            "datasource": "${DS_PROMETHEUS}",
            "description": "복제가 완전히 이루어지지 않은 파티션 수 (0이어야 정상)",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 10
            },
            "id": 7,
            "targets": [
                {
                    "expr": "kafka_server_ReplicaManager_UnderReplicatedPartitions",
                    "legendFormat": "Under Replicated",
                    "refId": "A"
                }
            ],
            "title": "복제 미완료 파티션 (Under Replicated)",
            "type": "stat"
        },
        {
            "datasource": "${DS_PROMETHEUS}",
            "description": "초당 유입되는 메시지 수",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 10
            },
            "id": 8,
            "targets": [
                {
                    "expr": "rate(kafka_server_BrokerTopicMetrics_MessagesInPerSec_Count[5m])",
                    "legendFormat": "Msg In/Sec",
                    "refId": "A"
                }
            ],
            "title": "초당 메시지 유입 (Message Rate)",
            "type": "timeseries"
        }
